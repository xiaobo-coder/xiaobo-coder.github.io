---
import '../styles/global.css';
import { profile, url } from '../utils/site';
interface Props { title?: string; description?: string; jsonld?: object | object[]; type?: string }
const { title, description = `${profile.name} — ${profile.headline}`, jsonld, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.headline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [['Papers', 'papers/'], ['Blog', 'blog/'], ['Projects', '#projects'], ['About', '#about']];
---
<!doctype html>
<html lang="en" class="overflow-x-clip">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={profile.name} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} /><meta property="og:type" content={type} /><meta property="og:url" content={canonical} />
  <link rel="alternate" type="application/rss+xml" title={`${profile.name} — blog`} href={url('rss.xml')} />
  <link rel="alternate" type="text/plain" title="Guide for AI agents (llms.txt)" href={url('llms.txt')} />
  <link rel="sitemap" type="application/xml" href={url('sitemap.xml')} />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <slot name="head" />
  <script is:inline>(function(){var t=null;try{t=localStorage.getItem('theme')}catch(_){};if(t==='dark'||(!t&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark')})();</script>
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/</g, '\\u003c')} />}
</head>
<body class="min-h-screen bg-[#f5f5f7] text-slate-800 antialiased dark:bg-[#0b0d12] dark:text-slate-200">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-teal-700 focus:px-3 focus:py-2 focus:text-white">Skip to content</a>
  <header class="sticky top-0 z-30 border-b border-black/[.06] bg-[#f5f5f7]/80 backdrop-blur dark:border-white/10 dark:bg-[#0b0d12]/80">
    <div class="mx-auto flex h-14 max-w-5xl items-center gap-6 px-5">
      <a href={url()} class="font-semibold tracking-tight text-slate-900 dark:text-white">{profile.name}</a>
      <nav aria-label="Main" class="flex items-center gap-1 text-sm">
        {nav.map(([l, h]) => { const href = h.startsWith('#') ? url() + h : url(h); const on = !h.startsWith('#') && path.startsWith('/' + h.replace(/\/$/, ''));
          return <a href={href} aria-current={on ? 'page' : undefined} class:list={['rounded-md px-2.5 py-1.5 hover:bg-black/5 dark:hover:bg-white/10', on ? 'font-medium text-slate-900 dark:text-white' : 'text-slate-600 dark:text-slate-400']}>{l}</a>; })}
      </nav>
      <button id="theme" type="button" class="ml-auto rounded-md px-2.5 py-1.5 text-xs text-slate-600 ring-1 ring-black/10 hover:bg-black/5 dark:text-slate-300 dark:ring-white/15 dark:hover:bg-white/10" aria-label="Toggle dark mode"><span class="dark:hidden">Dark</span><span class="hidden dark:inline">Light</span></button>
    </div>
  </header>
  <main id="main" class="mx-auto max-w-5xl px-5 pb-24 pt-10"><slot /></main>
  <footer class="border-t border-black/[.06] py-8 text-sm text-slate-500 dark:border-white/10 dark:text-slate-400">
    <div class="mx-auto flex max-w-5xl flex-wrap gap-x-6 gap-y-2 px-5">
      <span>© {new Date().getUTCFullYear()} {profile.name}</span>
      <span class="ml-auto flex flex-wrap gap-4">
        {Object.entries(profile.links).map(([k, v]) => <a class="hover:underline" href={v} rel="me noopener">{k}</a>)}
        <a class="hover:underline" href={url('rss.xml')}>RSS</a>
        <a class="hover:underline" href={url('llms.txt')}>For AI agents</a>
      </span>
    </div>
  </footer>
  <script is:inline>document.getElementById('theme').addEventListener('click',function(){var on=document.documentElement.classList.toggle('dark');try{localStorage.setItem('theme',on?'dark':'light')}catch(_){}});</script>
</body>
</html>
