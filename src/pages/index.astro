---
import Base from '../layouts/Base.astro';
import PaperCard from '../components/PaperCard.astro';
import { papers, posts, profile, url, fmtDate } from '../utils/site';
const jsonld = { '@context': 'https://schema.org', '@type': 'Person', name: profile.name, affiliation: { '@type': 'CollegeOrUniversity', name: profile.affiliation },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Xidian University', alternateName: '西安电子科技大学' },
  url: Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : undefined, sameAs: Object.values(profile.links), knowsAbout: ['LLM agents', 'AI for software engineering', 'AI agent security'] };
---
<Base jsonld={jsonld}>
  <section class="relative -mx-5 overflow-hidden px-5 pb-12 pt-6 sm:pt-12">
    <div class="grid-bg pointer-events-none absolute inset-0 -z-10"></div>
    <p class="eyebrow fade-in">{profile.affiliation}</p>
    <h1 class="display fade-in mt-4 max-w-4xl">{profile.name}.</h1>
    <p class="fade-in-2 mt-5 text-2xl font-semibold tracking-tight text-accent sm:text-3xl">{profile.headline}</p>
    <p class="fade-in-2 mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">{profile.bio}</p>
    <div class="fade-in-2 mt-8 flex flex-wrap gap-3">
      <a href={url('papers/')} class="rounded-full bg-slate-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">Papers</a>
      {Object.entries(profile.links).map(([k, v]) => <a href={v} rel="me noopener" class="rounded-full px-5 py-2.5 text-sm font-medium text-slate-700 ring-1 ring-black/10 hover:bg-black/5 dark:text-slate-200 dark:ring-white/15 dark:hover:bg-white/10">{k} ↗</a>)}
    </div>
  </section>

  <section class="mt-6">
    <div class="flex items-end justify-between"><div><p class="eyebrow">Research</p><h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Recent papers</h2></div>
      <a class="text-sm font-medium text-teal-700 hover:underline dark:text-teal-300" href={url('papers/')}>All {papers.length} papers ›</a></div>
    <div class="mt-6 space-y-5">{papers.slice(0, 3).map((p) => <PaperCard p={p} />)}</div>
  </section>

  <section class="mt-16">
    <div class="flex items-end justify-between"><div><p class="eyebrow">Writing</p><h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Blog</h2></div>
      {posts.length > 0 && <a class="text-sm font-medium text-teal-700 hover:underline dark:text-teal-300" href={url('blog/')}>All posts ›</a>}</div>
    {posts.length === 0
      ? <p class="mt-6 rounded-2xl p-8 text-center text-slate-500 ring-1 ring-dashed ring-black/10 dark:text-slate-400 dark:ring-white/15">Posts are coming soon.</p>
      : <ul class="mt-6 space-y-3">{posts.slice(0, 5).map((p) => <li><a href={url(`blog/${p.slug}/`)} class="card block p-5"><p class="eyebrow">{fmtDate(p.date)}</p><p class="mt-1 text-lg font-semibold text-slate-900 dark:text-white">{p.title}</p>{p.description && <p class="mt-1 text-slate-600 dark:text-slate-400">{p.description}</p>}</a></li>)}</ul>}
  </section>

  <section id="about" class="mt-16 scroll-mt-20">
    <p class="eyebrow">About</p><h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">About me</h2>
    <div class="mt-6 grid gap-5 lg:grid-cols-[1.4fr_1fr]">
      <div class="card p-6 sm:p-8">
        {profile.about.map((t) => <p class="mb-4 text-[17px] leading-relaxed text-slate-700 last:mb-0 dark:text-slate-300">{t}</p>)}
      </div>
      <div class="card p-6 sm:p-8">
        <p class="eyebrow">Education</p>
        <ul class="mt-3 space-y-3">{profile.education.map((e) => <li><p class="font-semibold text-slate-900 dark:text-white">{e.school}</p><p class="text-sm text-slate-600 dark:text-slate-400">{e.degree}</p></li>)}</ul>
        <p class="eyebrow mt-6">Collaboration</p>
        <p class="mt-2 text-slate-700 dark:text-slate-300">Email: <span class="font-mono text-[15px] text-slate-900 dark:text-white">{profile.contact.display}</span></p>
      </div>
    </div>
  </section>

  <section id="projects" class="mt-16 scroll-mt-20">
    <p class="eyebrow">Open source</p><h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Projects</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">{profile.projects.map((j) => (
      <a href={j.url} class="card block p-6"><p class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">{j.name} ›</p><p class="mt-2 text-slate-600 dark:text-slate-400">{j.description}</p></a>
    ))}</div>
  </section>
</Base>
