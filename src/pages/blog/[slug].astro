---
import Base from '../../layouts/Base.astro';
import { posts, profile, url, fmtDate, type Post } from '../../utils/site';
export function getStaticPaths() { return posts.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props as { p: Post };
const { Content } = p;
const jsonld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: p.title, description: p.description, datePublished: p.date, author: { '@type': 'Person', name: profile.name }, keywords: p.tags };
---
<Base title={p.title} description={p.description} jsonld={jsonld} type="article">
  <nav class="mb-8 text-sm"><a class="text-teal-700 hover:underline dark:text-teal-300" href={url('blog/')}>← All posts</a></nav>
  <article>
    <p class="eyebrow">{fmtDate(p.date)}{p.tags.length > 0 && ` · ${p.tags.join(' · ')}`}</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl dark:text-white">{p.title}</h1>
    {p.description && <p class="mt-4 max-w-2xl text-xl text-slate-600 dark:text-slate-400">{p.description}</p>}
    <div class="prose mt-10"><Content /></div>
  </article>
</Base>
